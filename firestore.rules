rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return estaLogado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function perfilAtual() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function perfilEhAdministrador(profile) {
      return !profile.keys().hasAny(["role"]) || profile.role == "admin";
    }

    function perfilEstaAtivo(profile) {
      return profile.get("archived", false) != true
        && profile.get("accessStatus", "active") != "blocked";
    }

    function contaAtiva() {
      return perfilExiste() && perfilEstaAtivo(perfilAtual());
    }

    function ehAdministrador() {
      return contaAtiva() && perfilEhAdministrador(perfilAtual());
    }

    function pertenceAoProprietario(ownerId) {
      return contaAtiva() && (
        request.auth.uid == ownerId ||
        (
          perfilExiste() &&
          (
            perfilAtual().ownerId == ownerId ||
            perfilAtual().teamId == ownerId
          )
        )
      );
    }

    function ehFuncionarioDoAdministrador(employeeId) {
      return contaAtiva()
        && exists(/databases/$(database)/documents/users/$(employeeId))
        && get(/databases/$(database)/documents/users/$(employeeId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(employeeId)).data.role in ["employee", "collaborator"]
        && perfilEstaAtivo(get(/databases/$(database)/documents/users/$(employeeId)).data);
    }

    match /users/{userId} {

      // Proprietário cria o próprio perfil ou cadastra um funcionário vinculado.
      allow create: if estaLogado() && (
        (
          request.auth.uid == userId &&
          request.resource.data.email == request.auth.token.email &&
          !request.resource.data.keys().hasAny(["ownerId", "teamId"]) &&
          (
            !request.resource.data.keys().hasAny(["role"]) ||
            request.resource.data.role == "admin"
          )
        ) ||
        (
          ehAdministrador() &&
          request.resource.data.role in ["employee", "collaborator"] &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.teamId == request.auth.uid
        )
      );

      // Usuário lê o próprio perfil; proprietário lê sua equipe;
      // funcionário pode ler o perfil do proprietário ao qual está vinculado.
      allow read: if (
        estaLogado() && request.auth.uid == userId
      ) || (
        contaAtiva() && (
          (
            ehAdministrador() &&
            (
              resource.data.ownerId == request.auth.uid ||
              resource.data.teamId == request.auth.uid
            )
          ) ||
          (
            userId == perfilAtual().ownerId ||
            userId == perfilAtual().teamId
          )
        )
      );

      // Proprietário atualiza as próprias informações pessoais.
      allow update: if contaAtiva() &&
        request.auth.uid == userId &&
        perfilEhAdministrador(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "age",
          "type",
          "document",
          "email",
          "profileIcon",
          "phone",
          "city",
          "state",
          "hectares",
          "plan",
          "planName",
          "updatedAt"
        ]);

      // Proprietário administra os dados cadastrais e trabalhistas de sua equipe.
      allow update: if ehAdministrador() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "age",
          "phone",
          "type",
          "document",
          "employmentType",
          "position",
          "sector",
          "droneModel",
          "status",
          "entry",
          "exit",
          "hours",
          "delays",
          "absences",
          "lastActivity",
          "inviteStatus",
          "archived",
          "archivedAt",
          "accessStatus",
          "updatedAt"
        ]);

      // Funcionário atualiza somente dados operacionais da própria jornada.
      allow update: if contaAtiva() &&
        request.auth.uid == userId &&
        resource.data.role in ["employee", "collaborator"] &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "entry",
          "exit",
          "hours",
          "workStartedAt",
          "workEndedAt",
          "lastActivity",
          "updatedAt"
        ]);

      // O plano gratuito preserva o histórico e revoga o acesso por
      // archived/accessStatus; exclusão física pelo cliente não é permitida.
      allow delete: if false;
    }

    match /farms/{farmId} {

      allow create: if ehAdministrador()
                    && request.resource.data.ownerId == request.auth.uid;

      allow read: if pertenceAoProprietario(resource.data.ownerId);

      allow update, delete: if ehAdministrador()
                            && resource.data.ownerId == request.auth.uid
                            && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /tasks/{taskId} {

      allow create: if ehAdministrador()
                    && request.resource.data.ownerId == request.auth.uid
                    && ehFuncionarioDoAdministrador(request.resource.data.employeeId);

      allow read: if contaAtiva() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );

      // Proprietário administra tarefas de sua equipe.
      allow update: if ehAdministrador()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.employeeId == resource.data.employeeId;

      // Funcionário pode iniciar ou concluir somente uma tarefa atribuída a ele.
      allow update: if contaAtiva()
                    && resource.data.employeeId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.employeeId == resource.data.employeeId
                    && request.resource.data.status in ["andamento", "concluida"]
                    && request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly([
                        "status",
                        "startedAt",
                        "completedAt",
                        "updatedAt"
                      ]);

      allow delete: if ehAdministrador()
                    && resource.data.ownerId == request.auth.uid;
    }

    match /activities/{activityId} {

      // O proprietário publica uma atividade para toda a fazenda ou para um
      // funcionário que pertença à própria equipe.
      allow create: if ehAdministrador()
                    && request.resource.data.ownerId == request.auth.uid
                    && (
                      request.resource.data.scope == "general" ||
                      (
                        request.resource.data.scope == "individual" &&
                        ehFuncionarioDoAdministrador(request.resource.data.assigneeId)
                      )
                    );

      // O proprietário vê toda a operação. O funcionário vê os comunicados
      // gerais da sua fazenda e as atividades atribuídas diretamente a ele.
      allow read: if contaAtiva() && (
        resource.data.ownerId == request.auth.uid ||
        (
          resource.data.scope == "general" &&
          pertenceAoProprietario(resource.data.ownerId)
        ) ||
        resource.data.assigneeId == request.auth.uid
      );

      allow update: if ehAdministrador()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && (
                      request.resource.data.scope == "general" ||
                      (
                        request.resource.data.scope == "individual" &&
                        ehFuncionarioDoAdministrador(request.resource.data.assigneeId)
                      )
                    );

      // O funcionário designado pode apenas iniciar ou concluir a atividade.
      allow update: if contaAtiva()
                    && resource.data.assigneeId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.assigneeId == resource.data.assigneeId
                    && request.resource.data.status in ["em_andamento", "concluida"]
                    && request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly([
                        "status",
                        "startedAt",
                        "completedAt",
                        "updatedAt"
                      ]);

      allow delete: if ehAdministrador()
                    && resource.data.ownerId == request.auth.uid;
    }

    // Tudo que não foi declarado acima permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
  
}
