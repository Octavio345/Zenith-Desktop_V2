rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return estaLogado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function perfilAtual() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function perfilEhAdministrador(profile) {
      return !profile.keys().hasAny(["role"]) || profile.role == "admin";
    }

    function perfilEstaAtivo(profile) {
      return profile.get("archived", false) != true
        && profile.get("accessStatus", "active") != "blocked";
    }

    function contaAtiva() {
      return perfilExiste() && perfilEstaAtivo(perfilAtual());
    }

    function emailConfirmado() {
      return estaLogado() && request.auth.token.email_verified == true;
    }

    function ehAdministrador() {
      return contaAtiva() && perfilEhAdministrador(perfilAtual());
    }

    function administradorConfirmado() {
      return ehAdministrador() && emailConfirmado();
    }

    function pertenceAoProprietario(ownerId) {
      return contaAtiva() && (
        request.auth.uid == ownerId ||
        (
          perfilExiste() &&
          (
            perfilAtual().ownerId == ownerId ||
            perfilAtual().teamId == ownerId
          )
        )
      );
    }

    function ehFuncionarioDoAdministrador(employeeId) {
      return contaAtiva()
        && exists(/databases/$(database)/documents/users/$(employeeId))
        && get(/databases/$(database)/documents/users/$(employeeId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(employeeId)).data.role in ["employee", "collaborator"]
        && perfilEstaAtivo(get(/databases/$(database)/documents/users/$(employeeId)).data);
    }

    function funcionarioIniciaTarefa() {
      return resource.data.status == "pendente"
        && request.resource.data.status == "andamento"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "startedAt",
          "updatedAt"
        ]);
    }

    function funcionarioConcluiTarefa() {
      return resource.data.status == "andamento"
        && request.resource.data.status == "concluida"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "completedAt",
          "updatedAt"
        ]);
    }

    function funcionarioIniciaAtividade() {
      return resource.data.status == "pendente"
        && request.resource.data.status == "em_andamento"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "startedAt",
          "updatedAt"
        ]);
    }

    function funcionarioConcluiAtividade() {
      return resource.data.status == "em_andamento"
        && request.resource.data.status == "concluida"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "completedAt",
          "updatedAt"
        ]);
    }

    match /users/{userId} {


      allow create: if estaLogado() && (
        (
          request.auth.uid == userId &&
          request.resource.data.email == request.auth.token.email &&
          !request.resource.data.keys().hasAny(["ownerId", "teamId"]) &&
          (
            !request.resource.data.keys().hasAny(["role"]) ||
            request.resource.data.role == "admin"
          )
        ) ||
        (
          administradorConfirmado() &&
          request.resource.data.role in ["employee", "collaborator"] &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.teamId == request.auth.uid
        )
      );



      allow read: if (
        estaLogado() && request.auth.uid == userId
      ) || (
        contaAtiva() && (
          (
            ehAdministrador() &&
            (
              resource.data.ownerId == request.auth.uid ||
              resource.data.teamId == request.auth.uid
            )
          ) ||
          (
            userId == perfilAtual().ownerId ||
            userId == perfilAtual().teamId
          )
        )
      );


      allow update: if contaAtiva() &&
        request.auth.uid == userId &&
        perfilEhAdministrador(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "age",
          "type",
          "document",
          "email",
          "profileIcon",
          "phone",
          "city",
          "state",
          "hectares",
          "plan",
          "planName",
          "updatedAt"
        ]);


      allow update: if administradorConfirmado() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "age",
          "phone",
          "type",
          "document",
          "employmentType",
          "position",
          "sector",
          "droneModel",
          "status",
          "entry",
          "exit",
          "hours",
          "delays",
          "absences",
          "lastActivity",
          "inviteStatus",
          "archived",
          "archivedAt",
          "accessStatus",
          "updatedAt"
        ]);


      allow update: if contaAtiva() &&
        request.auth.uid == userId &&
        resource.data.role in ["employee", "collaborator"] &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "entry",
          "exit",
          "hours",
          "workStartedAt",
          "workEndedAt",
          "lastActivity",
          "updatedAt"
        ]);



      allow delete: if false;
    }

    match /farms/{farmId} {

      allow create: if ehAdministrador()
                    && request.resource.data.ownerId == request.auth.uid;

      allow read: if pertenceAoProprietario(resource.data.ownerId);

      allow update, delete: if ehAdministrador()
                            && resource.data.ownerId == request.auth.uid
                            && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /tasks/{taskId} {

      allow create: if administradorConfirmado()
                    && request.resource.data.ownerId == request.auth.uid
                    && ehFuncionarioDoAdministrador(request.resource.data.employeeId);

      allow read: if contaAtiva() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );


      allow update: if administradorConfirmado()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.employeeId == resource.data.employeeId;


      allow update: if contaAtiva()
                    && resource.data.employeeId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.employeeId == resource.data.employeeId
                    && (funcionarioIniciaTarefa() || funcionarioConcluiTarefa());

      allow delete: if administradorConfirmado()
                    && resource.data.ownerId == request.auth.uid;
    }

    match /activities/{activityId} {



      allow create: if administradorConfirmado()
                    && request.resource.data.ownerId == request.auth.uid
                    && (
                      request.resource.data.scope == "general" ||
                      (
                        request.resource.data.scope == "individual" &&
                        ehFuncionarioDoAdministrador(request.resource.data.assigneeId)
                      )
                    );



      allow read: if contaAtiva() && (
        resource.data.ownerId == request.auth.uid ||
        (
          resource.data.scope == "general" &&
          pertenceAoProprietario(resource.data.ownerId)
        ) ||
        resource.data.assigneeId == request.auth.uid
      );

      allow update: if administradorConfirmado()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && (
                      request.resource.data.scope == "general" ||
                      (
                        request.resource.data.scope == "individual" &&
                        ehFuncionarioDoAdministrador(request.resource.data.assigneeId)
                      )
                    );


      allow update: if contaAtiva()
                    && resource.data.assigneeId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.assigneeId == resource.data.assigneeId
                    && (funcionarioIniciaAtividade() || funcionarioConcluiAtividade());

      allow delete: if administradorConfirmado()
                    && resource.data.ownerId == request.auth.uid;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }

}
